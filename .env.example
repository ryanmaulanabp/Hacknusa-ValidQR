# ==========================================
# ValidQR (NusaPay) Web App Environment Configuration
# ==========================================

# ── Cloud PostgreSQL Database (Supabase / Neon) ──
# Ganti dengan connection string Cloud PostgreSQL Anda (tidak perlu Docker!)
# Format Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Format Neon: postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── ValidQR Security Rules ──
GEOFENCE_RADIUS_METERS=20
FUZZY_WARNING_THRESHOLD=50

# ── WhatsApp Bot Alerts (Optional - Fonnte API) ──
FONNTE_TOKEN=
WHATSAPP_ALERT_TARGET=6281234567890
